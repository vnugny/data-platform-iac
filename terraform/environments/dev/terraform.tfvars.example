# Copy to terraform.tfvars and fill in real values (terraform.tfvars is gitignored).

aws_region = "us-east-1"

# Networking the platform deploys into
vpc_id     = "vpc-xxxxxxxx"
subnet_ids = ["subnet-xxxxxxxx", "subnet-yyyyyyyy"]

# Database credentials (keep out of version control; prefer a secrets manager in real use)
airflow_db_password   = "change-me"
warehouse_db_password = "change-me"
